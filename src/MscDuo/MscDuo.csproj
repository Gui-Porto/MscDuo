<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MscDuo</AssemblyName>
    <RootNamespace>MscDuo</RootNamespace>
    <Version>0.1.0</Version>
    <Product>MSC Duo</Product>
    <Authors>Kauan</Authors>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\My Summer Car</GameDir>
    <ModsDir Condition="'$(ModsDir)' == ''">$(USERPROFILE)\Documents\MySummerCar\Mods</ModsDir>
    <ManagedDir>$(GameDir)\mysummercar_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MSCLoader">
      <HintPath>$(ManagedDir)\MSCLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(ManagedDir)\PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ES2">
      <HintPath>$(ManagedDir)\ES2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyTrademarkAttribute">
      <_Parameter1>Contains AI-generated code (Claude, Anthropic), reviewed by the author.</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../blender/extensao.obj" LogicalName="MscDuo.extensao.obj" />
    <EmbeddedResource Include="../../blender/extensao.png" LogicalName="MscDuo.extensao.png" />
    <EmbeddedResource Include="../../blender/aterro.obj" LogicalName="MscDuo.aterro.obj" />
    <EmbeddedResource Include="../../blender/galpao_jogo.obj" LogicalName="MscDuo.galpao_jogo.obj" />
    <EmbeddedResource Include="../../blender/plataforma_jogo.obj" LogicalName="MscDuo.plataforma_jogo.obj" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/aco.png" LogicalName="MscDuo.galpao.aco.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/chapa.png" LogicalName="MscDuo.galpao.chapa.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/concreto.png" LogicalName="MscDuo.galpao.concreto.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/degrau.png" LogicalName="MscDuo.galpao.degrau.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/faixa.png" LogicalName="MscDuo.galpao.faixa.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/laje.png" LogicalName="MscDuo.galpao.laje.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/luz.png" LogicalName="MscDuo.galpao.luz.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/parede.png" LogicalName="MscDuo.galpao.parede.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/porta.png" LogicalName="MscDuo.galpao.porta.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/portao.png" LogicalName="MscDuo.galpao.portao.png" />
    <EmbeddedResource Include="../../blender/galpao_tex_jogo/vidro.png" LogicalName="MscDuo.galpao.vidro.png" />
  </ItemGroup>

  <Target Name="DeployToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsDir)" />
    <Message Importance="high" Text="MscDuo.dll copiado para $(ModsDir)" />
  </Target>

</Project>
